{
  "name": "server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "pnpm --filter @job-search-facilitator/core run generate",
    "dev": "tsx watch src/server.ts",
    "prebuild": "pnpm --filter @job-search-facilitator/core run generate",
    "build": "tsup",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "pretypecheck": "pnpm --filter @job-search-facilitator/core run generate",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src tests",
    "format:check": "prettier --check src tests",
    "lint": "eslint src tests --max-warnings=0"
  },
  "dependencies": {
    "@job-search-facilitator/core": "workspace:*",
    "@job-search-facilitator/utils": "workspace:*",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "close-with-grace": "^2.5.0",
    "cors": "^2.8.5",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "pg": "^8.19.0",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/pg": "^8.16.0",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.2.2",
    "tsup": "^8.5.1",
    "tsx": "^4.23.0",
    "vitest": "^4.1.9"
  }
}
