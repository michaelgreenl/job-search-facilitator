enum OutreachRunStatus {
  PENDING   @map("pending")
  RUNNING   @map("running")
  COMPLETED @map("completed")
  FAILED    @map("failed")
}

model OutreachRun {
  id                    String            @id @default(uuid()) @db.Uuid
  jobPostId             String            @db.Uuid
  requestedContactCount Int
  status                OutreachRunStatus @default(PENDING)
  agentTaskId           String?           @db.Uuid
  agentThreadId         String?
  agentTurnId           String?
  error                 String?
  completedAt           DateTime?         @db.Timestamptz(3)
  createdAt             DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime          @updatedAt @db.Timestamptz(3)
  jobPost               JobPost           @relation(fields: [jobPostId], references: [id], onDelete: Cascade)

  @@index([jobPostId])
}

model OutreachContact {
  id                 String             @id @default(uuid()) @db.Uuid
  jobPostId          String             @db.Uuid
  personName         String
  personTitle        String
  profileUrl         String
  relevanceRationale String
  draftMessage       String
  messaged           Boolean            @default(false)
  createdAt          DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime           @updatedAt @db.Timestamptz(3)
  jobPost            JobPost            @relation(fields: [jobPostId], references: [id], onDelete: Cascade)
  trackingActivities TrackingActivity[]

  @@index([jobPostId])
}
