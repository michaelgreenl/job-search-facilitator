enum AgentLabel {
  TARGET    @map("target")
  QUICK_APP @map("quick-app")
}

model JobSearchReport {
  id         String            @id @default(uuid()) @db.Uuid
  reportDate DateTime          @db.Date
  summary    String
  archivedAt DateTime?         @db.Timestamptz(3)
  createdAt  DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime          @updatedAt @db.Timestamptz(3)
  results    JobSearchResult[]
}

model JobSearchResult {
  reportId             String          @db.Uuid
  postId               String          @db.Uuid
  agentRank            Int
  agentLabel           AgentLabel
  fitRationale         String
  applicationFlow      String
  keyLegitimacySignals String
  recommendedResume    String
  recommendedAction    String
  legitimacyNotes      String?
  report               JobSearchReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  post                 JobPost         @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([reportId, postId])
  @@unique([reportId, agentRank])
}
