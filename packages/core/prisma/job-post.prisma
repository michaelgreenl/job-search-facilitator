enum ApplicationStatus {
  NOT_APPLIED       @map("not-applied")
  AWAITING_RESPONSE @map("awaiting-response")
  INTERVIEWING      @map("interviewing")
  REJECTED          @map("rejected")
  HIRED             @map("hired")
}

enum PostStatus {
  UNKNOWN @map("unknown")
  ACTIVE  @map("active")
  CLOSED  @map("closed")
}

enum UserLabel {
  P1
  P2
  QUICK_APP @map("quick-app")
  FORGO     @map("forgo")
}

model JobPost {
  id                         String               @id @default(uuid()) @db.Uuid
  sourceKey                  String               @unique
  roleTitle                  String
  company                    String
  location                   String?
  compensation               String?
  techStack                  String
  postSource                 String
  postUrl                    String
  applicationUrl             String
  postStatus                 PostStatus           @default(UNKNOWN)
  applicationStatus          ApplicationStatus    @default(NOT_APPLIED)
  appliedAt                  DateTime?            @db.Timestamptz(3)
  applicationStatusUpdatedAt DateTime?            @db.Timestamptz(3)
  userLabel                  UserLabel?
  archivedAt                 DateTime?            @db.Timestamptz(3)
  createdAt                  DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt                  DateTime             @updatedAt @db.Timestamptz(3)
  results                    JobSearchResult[]
  outreachContacts           OutreachContact[]
  outreachRuns               OutreachRun[]
  userAdded                  UserAddedJobPost?
  snapshot                   JobPostSnapshot?
  applicationSnapshot        ApplicationSnapshot?
  applicationArtifacts       ApplicationArtifact[]
  activities                 JobPostActivity[]
}

model JobPostSnapshot {
  jobPostId   String   @id @db.Uuid
  description String
  sourceUrl   String
  capturedAt  DateTime @db.Timestamptz(3)
  jobPost     JobPost  @relation(fields: [jobPostId], references: [id], onDelete: Cascade)
}

model UserAddedJobPost {
  postId               String     @id @db.Uuid
  agentLabel           AgentLabel
  fitRationale         String
  applicationFlow      String
  keyLegitimacySignals String
  recommendedResume    ResumeType
  recommendedAction    String
  legitimacyNotes      String?
  createdAt            DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime   @updatedAt @db.Timestamptz(3)
  post                 JobPost    @relation(fields: [postId], references: [id], onDelete: Cascade)
}
