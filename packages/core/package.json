{
    "name": "@job-search-facilitator/core",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "main": "./src/index.ts",
    "types": "./src/index.ts",
    "exports": {
        ".": "./src/index.ts",
        "./prisma": "./src/prisma.ts"
    },
    "scripts": {
        "generate": "prisma generate",
        "test": "node --test scripts/*.test.ts",
        "validate": "prisma validate",
        "db:push": "prisma db push",
        "db:reset": "node scripts/assert-local-database.ts && prisma migrate reset --force",
        "db:migrate": "prisma migrate dev",
        "db:deploy": "prisma migrate deploy",
        "db:seed": "prisma db seed",
        "db:studio": "prisma studio",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@prisma/client": "^7.8.0",
        "zod": "4.4.3"
    },
    "devDependencies": {
        "@prisma/adapter-pg": "^7.8.0",
        "dotenv": "^17.3.1",
        "prisma": "^7.8.0"
    }
}
