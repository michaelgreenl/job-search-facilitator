{
  "name": "@job-search-facilitator/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./prisma": "./src/prisma.ts"
  },
  "scripts": {
    "generate": "prisma generate",
    "validate": "prisma validate",
    "db:push": "prisma db push",
    "db:reset": "prisma db push --force-reset",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "pretypecheck": "pnpm run generate",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src prisma prisma.config.ts",
    "format:check": "prettier --check src prisma prisma.config.ts",
    "lint": "eslint src prisma.config.ts --max-warnings=0"
  },
  "dependencies": {
    "@prisma/client": "^7.8.0"
  },
  "devDependencies": {
    "dotenv": "^17.3.1",
    "prisma": "^7.8.0"
  }
}
